# ============================================
# EDUCA+ Curionópolis - Environment Variables
# ============================================
# Copy this file to .env and update the values
# NEVER commit .env file to version control!

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://postgres:YOUR_SECURE_PASSWORD@localhost:5432/educacurionopolis

# ============================================
# JWT/AUTHENTICATION CONFIGURATION
# ============================================
# IMPORTANT: Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_64_CHARACTER_HEX_STRING

# Algorithm for JWT encoding (do not change unless necessary)
ALGORITHM=HS256

# Token expiration in minutes (default: 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================
# CORS CONFIGURATION
# ============================================
# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins
# In production, only include your actual domain(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Allow credentials in CORS requests
CORS_ALLOW_CREDENTIALS=True

# ============================================
# APPLICATION SETTINGS
# ============================================
# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (set to False in production!)
DEBUG=True

# Application name and version
APP_NAME=EDUCA+ Curionópolis
APP_VERSION=1.0.0

# ============================================
# SECURITY SETTINGS
# ============================================
# Comma-separated list of allowed hosts (for production)
# Example: ALLOWED_HOSTS=educacurionopolis.pa.gov.br,www.educacurionopolis.pa.gov.br
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# PRODUCTION CHECKLIST
# ============================================
# Before deploying to production, ensure:
# 1. SECRET_KEY is a strong, unique value (64 hex characters)
# 2. DATABASE_URL uses a strong password
# 3. DEBUG=False
# 4. ENVIRONMENT=production
# 5. CORS_ORIGINS only includes your production domain
# 6. ALLOWED_HOSTS only includes your production domain
# 7. This .env file is NOT committed to version control
