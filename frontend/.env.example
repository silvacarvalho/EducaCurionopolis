# ============================================
# EDUCA+ Curionópolis Frontend - Environment Variables
# ============================================
# Copy this file to .env and update the values
# NEVER commit .env file to version control!

# ============================================
# API CONFIGURATION
# ============================================
# Backend API URL
VITE_API_URL=http://localhost:8000

# ============================================
# APPLICATION SETTINGS
# ============================================
# Application name
VITE_APP_NAME=EDUCA+ Curionópolis

# Environment (development, staging, production)
VITE_ENVIRONMENT=development

# ============================================
# PRODUCTION NOTES
# ============================================
# In production:
# 1. VITE_API_URL should point to your production API
# 2. VITE_ENVIRONMENT should be set to "production"
# 3. All VITE_ prefixed variables are exposed to the client
#    - Do NOT put secrets in VITE_ variables!
